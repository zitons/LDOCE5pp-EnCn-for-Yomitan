# ============================================================
#  源数据：1.3 GB + 878 MB，且受版权保护，绝不入库
# ============================================================
*.mdd
*.mdx
extract/

# ============================================================
#  第三方副本（可自行获取，避免把别人的代码当成自己的成果）
# ============================================================
yomitan-ext/
yomitan-chrome.zip
OALD10-Yomitan-Converter/
venv/
scgen_test/node_modules/

# ============================================================
#  构建 / 调试产物
# ============================================================
converter/_bench_sample.pkl
converter/*.bak
converter/*.bak-*
converter/dbg*.py
__pycache__/
*.pyc
_baseline/
yomitan_debug*/
yomitan_mono*/
scgen_test/payload.json

# ============================================================
#  侦察草稿与一次性测量页（可由脚本重新生成）
# ============================================================
_*.html
d_*.txt
dump_*.txt
tree_*.txt
questions*.txt
corpus_profile.json
ym_*.js
ym-translator-results.json
.chrome-*/

# ============================================================
#  工作区内部记录（结论已提炼进 REVIEW/HANDOVER）
# ============================================================
.workbuddy/

# ============================================================
#  根目录的一次性侦察产物（结论已写进文档）
# ============================================================
/*.py
/*.json
/*.txt
/*.ts
/*.js
/*.css

# ============================================================
#  成品词典包（走 GitHub Release 附件，见 README）
#  ⚠ 60 MB 的单次 git push 会在约 19 秒后被链路重置，故不入库
# ============================================================
yomitan_full/*.zip

# 临时调试构建（与 yomitan_debug*/ 同类）
yomitan_wf_test/

# ============================================================
#  审计 / 构建日志：可重跑生成，不入库
#  （数字已固化进 REVIEW.md / HANDOVER.md。库里留着 46 个日志会造成
#    "读到过期结论"的坑 —— 本次审查就被 stale 日志误导过一次。）
# ============================================================
*.log

# ============================================================
#  一次性补丁脚本：保留可复用的恢复框架，忽略用完即弃的补丁
#  _apply_patch.py（原子写 + assert）与 _restore_all.py（补丁重放记录）
#  被 REVIEW.md D15 引用，故保留在库中。
# ============================================================
converter/_*.py
!converter/_apply_patch.py
!converter/_restore_all.py
